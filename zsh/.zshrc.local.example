# Copy this file to ~/.zshrc.local and edit it for your machine/team.
# It is sourced by the shared ~/.zshrc near the end of initialization.

# Machine- or org-specific exports.
export AWS_REGION="ap-northeast-1"
# Gateway for Claude Code: leave commented on subscription/OAuth machines (an unreachable BASE_URL makes Claude Code fail with ConnectionRefused at startup); uncomment only when this machine routes through a real gateway.
# export ANTHROPIC_BASE_URL_DEFAULT="https://llm-gateway.example.internal"
# export ANTHROPIC_BASE_URL="$ANTHROPIC_BASE_URL_DEFAULT"
# Claude Code appends /v1/messages; include any gateway prefix needed before /v1.
# export ANTHROPIC_BASE_URL_JBRIDGE="https://jbridge.example.internal/api"
# export ANTHROPIC_BASE_URL_WEB="https://litellm.example.internal"
# Pin provider-specific model ids for Claude Code. Some gateways reject [1m]
# aliases in raw /v1/messages calls but Claude Code still accepts them via
# /model; use the Claude Code-accepted id here, not only the raw API catalog.
# export ANTHROPIC_MODEL_JBRIDGE_OPUS="claude-opus-4-7[1m]"
# export ANTHROPIC_MODEL_JBRIDGE_SONNET="claude-sonnet-4-6[1m]"
# export ANTHROPIC_MODEL_JBRIDGE_HAIKU="$ANTHROPIC_MODEL_JBRIDGE_SONNET"
# export ANTHROPIC_MODEL_JBRIDGE="$ANTHROPIC_MODEL_JBRIDGE_OPUS"
export GITLAB_API_URL="https://gitlab.example.internal"
# Optional separate Codex home for a personal subscription account.
# export CODEX_SUB_HOME="$HOME/.codex-sub"
# Optional 1Password ref for `claude setup-token`; used only for `claude-sub -p`.
# export CLAUDE_SUB_OAUTH_TOKEN_OP_REF="op://Vault/Item/claude_code_oauth_token_sub"

# 1Password secret references used by `with-secrets` and related wrappers.
export ANTHROPIC_AUTH_TOKEN_OP_REF_DEFAULT="op://Vault/Item/anthropic_auth_token"
export ANTHROPIC_AUTH_TOKEN_OP_REF_JBRIDGE="op://Vault/Item/anthropic_auth_token_jbridge"
export ANTHROPIC_AUTH_TOKEN_OP_REF_WEB="op://Vault/Item/web_litellm"
export ANTHROPIC_AUTH_TOKEN_OP_REF="$ANTHROPIC_AUTH_TOKEN_OP_REF_DEFAULT"
# Optional 1Password ref used by ccr-start for ~/.claude-code-router/config.json
# entries such as "api_key": "$ANTHROPIC_AUTH_TOKEN".
# export CCR_ANTHROPIC_AUTH_TOKEN_OP_REF="$ANTHROPIC_AUTH_TOKEN_OP_REF_DEFAULT"
export GITLAB_PERSONAL_ACCESS_TOKEN_OP_REF="op://Vault/Item/gitlab_personal_access_token"
export PAGERDUTY_API_KEY_OP_REF="op://Vault/Item/pagerduty_api_key"
export PAGERDUTY_USER_API_KEY_OP_REF="op://Vault/Item/pagerduty_user_api_key"

# Drop retired wrappers when this file is sourced in an existing shell.
unfunction claude-azure 2>/dev/null || true

claude-jbridge() {
  local _bin _arg _has_model
  local -a _model_args
  _bin=$(whence -p claude) || { echo "claude not found" >&2; return 127; }

  for _arg in "$@"; do
    case "$_arg" in
      --model|-m|--model=*) _has_model=1 ;;
    esac
  done
  [[ -z "$_has_model" && -n "${ANTHROPIC_MODEL_JBRIDGE:-}" ]] && _model_args=(--model "$ANTHROPIC_MODEL_JBRIDGE")

  if [[ -n "${ANTHROPIC_BASE_URL_JBRIDGE:-}" ]]; then
    ANTHROPIC_AUTH_TOKEN_OP_REF="$ANTHROPIC_AUTH_TOKEN_OP_REF_JBRIDGE" \
      ANTHROPIC_BASE_URL="$ANTHROPIC_BASE_URL_JBRIDGE" \
      ANTHROPIC_DEFAULT_OPUS_MODEL="${ANTHROPIC_MODEL_JBRIDGE_OPUS:-}" \
      ANTHROPIC_DEFAULT_SONNET_MODEL="${ANTHROPIC_MODEL_JBRIDGE_SONNET:-}" \
      ANTHROPIC_DEFAULT_HAIKU_MODEL="${ANTHROPIC_MODEL_JBRIDGE_HAIKU:-}" \
      env -u CLAUDE_CODE_USE_FOUNDRY -u ANTHROPIC_FOUNDRY_BASE_URL -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_MODEL "$_bin" "${_model_args[@]}" "$@"
  else
    ANTHROPIC_AUTH_TOKEN_OP_REF="$ANTHROPIC_AUTH_TOKEN_OP_REF_JBRIDGE" \
      ANTHROPIC_DEFAULT_OPUS_MODEL="${ANTHROPIC_MODEL_JBRIDGE_OPUS:-}" \
      ANTHROPIC_DEFAULT_SONNET_MODEL="${ANTHROPIC_MODEL_JBRIDGE_SONNET:-}" \
      ANTHROPIC_DEFAULT_HAIKU_MODEL="${ANTHROPIC_MODEL_JBRIDGE_HAIKU:-}" \
      env -u CLAUDE_CODE_USE_FOUNDRY -u ANTHROPIC_FOUNDRY_BASE_URL -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_MODEL -u ANTHROPIC_BASE_URL "$_bin" "${_model_args[@]}" "$@"
  fi
}

claude-jb() {
  claude-jbridge "$@"
}

claude-web() {
  local _bin _token
  _bin=$(whence -p claude) || { echo "claude not found" >&2; return 127; }

  _token=$(ANTHROPIC_AUTH_TOKEN_OP_REF="${ANTHROPIC_AUTH_TOKEN_OP_REF_WEB:-op://Vault/Item/web_litellm}" \
           "$HOME/.claude/api-key-helper.sh") \
    || { echo "claude-web: could not resolve web API token from 1Password (run 'op signin')" >&2; return 1; }

  env -u ANTHROPIC_API_KEY \
      -u ANTHROPIC_API_BASE_URL \
      -u CLAUDE_AGENT_API_BASE_URL \
      -u CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY \
      ANTHROPIC_AUTH_TOKEN="$_token" \
      ANTHROPIC_BASE_URL="${ANTHROPIC_BASE_URL_WEB:-https://litellm.example.internal}" \
      "$_bin" "$@"
}

claude-sub() {
  local _bin _arg _is_print _oauth_token _op_bin _audit_plugin_dir
  local -a _oauth_env _audit_args _launch_command
  _bin=$(whence -p claude) || { echo "claude not found" >&2; return 127; }

  _audit_plugin_dir="${AIRKIT_AUDIT_PLUGIN_DIR:-$HOME/.config/ai-runtime-kit/plugins/airkit-context}"
  if [[ -f "$_audit_plugin_dir/.claude-plugin/plugin.json" ]]; then
    for _arg in "$@"; do
      [[ "$_arg" == "--plugin-dir" || "$_arg" == --plugin-dir=* ]] && break
    done
    if [[ -z "$_arg" || ( "$_arg" != "--plugin-dir" && "$_arg" != --plugin-dir=* ) ]]; then
      _audit_args=(--plugin-dir "$_audit_plugin_dir")
    fi
  fi

  for _arg in "$@"; do
    case "$_arg" in
      -p|--print) _is_print=1 ;;
    esac
  done

  if [[ -n "$_is_print" && -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
    if [[ -z "${CLAUDE_SUB_OAUTH_TOKEN_OP_REF:-}" ]]; then
      echo "claude-sub -p requires CLAUDE_CODE_OAUTH_TOKEN or CLAUDE_SUB_OAUTH_TOKEN_OP_REF." >&2
      echo "Run 'claude-sub setup-token' and store the token in 1Password." >&2
      return 1
    fi
    _op_bin=${OP_BIN:-/opt/homebrew/bin/op}
    [[ -x "$_op_bin" ]] || _op_bin=$(command -v op 2>/dev/null) || {
      echo "op not found; cannot read CLAUDE_SUB_OAUTH_TOKEN_OP_REF" >&2
      return 127
    }
    _oauth_token=$("$_op_bin" read "$CLAUDE_SUB_OAUTH_TOKEN_OP_REF" --no-newline) || {
      echo "Unable to read CLAUDE_SUB_OAUTH_TOKEN_OP_REF from 1Password." >&2
      echo "Run 'claude-sub setup-token' and store it at: $CLAUDE_SUB_OAUTH_TOKEN_OP_REF" >&2
      return 1
    }
    _oauth_env=(CLAUDE_CODE_OAUTH_TOKEN="$_oauth_token")
  fi

  if [[ "${AIRKIT_SHIELD_SUBSCRIPTION:-}" == "1" ]]; then
    _launch_command=(command airkit shield launch --lane subscription -- "$_bin")
  else
    _launch_command=("$_bin")
  fi

  # Plain `claude` routes to the company gateway from shell env (its own
  # ANTHROPIC_BASE_URL plus a command-scoped token in the claude() wrapper),
  # so unsetting those company-line vars here reaches the personal subscription
  # instead. User settings stay fully loaded: statusline, hooks, and
  # permissions keep working, and detach/reattach is safe.
  # REQUIRES the CCR "Claude Code" agent profile to no longer be 系统默认
  # (system default) in `ccr ui`, AND the ~/.claude/settings.json apiKeyHelper
  # to stay removed: either one would inject or outrank a company key and auth
  # against it instead of the subscription.
  # Keep CLAUDE_CONFIG_DIR unchanged so sessions stay shared.
  CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=0 \
    env -u ANTHROPIC_AUTH_TOKEN \
    -u ANTHROPIC_API_KEY \
    -u ANTHROPIC_BASE_URL \
    -u ANTHROPIC_API_BASE_URL \
    -u CLAUDE_AGENT_API_BASE_URL \
    -u ANTHROPIC_BASE_URL_DEFAULT \
    -u ANTHROPIC_BASE_URL_JBRIDGE \
    -u ANTHROPIC_BASE_URL_WEB \
    -u ANTHROPIC_BASE_URL_AZURE \
    -u ANTHROPIC_AUTH_TOKEN_OP_REF \
    -u ANTHROPIC_AUTH_TOKEN_OP_REF_DEFAULT \
    -u ANTHROPIC_AUTH_TOKEN_OP_REF_JBRIDGE \
    -u ANTHROPIC_AUTH_TOKEN_OP_REF_WEB \
    -u ANTHROPIC_AUTH_TOKEN_OP_REF_AZURE \
    -u ANTHROPIC_AUTH_TOKEN_OP_REF_ALT1 \
    -u ANTHROPIC_MODEL \
    -u ANTHROPIC_MODEL_JBRIDGE \
    -u ANTHROPIC_MODEL_JBRIDGE_OPUS \
    -u ANTHROPIC_MODEL_JBRIDGE_SONNET \
    -u ANTHROPIC_MODEL_JBRIDGE_HAIKU \
    -u ANTHROPIC_MODEL_AZURE \
    -u ANTHROPIC_MODEL_AZURE_OPUS \
    -u ANTHROPIC_MODEL_AZURE_SONNET \
    -u ANTHROPIC_MODEL_AZURE_HAIKU \
    -u ANTHROPIC_DEFAULT_OPUS_MODEL \
    -u ANTHROPIC_DEFAULT_SONNET_MODEL \
    -u ANTHROPIC_DEFAULT_HAIKU_MODEL \
    -u ANTHROPIC_FOUNDRY_BASE_URL \
    -u ANTHROPIC_FOUNDRY_BASE_URL_AZURE \
    -u ANTHROPIC_1M_CONTEXT \
    -u ANTHROPIC_CUSTOM_HEADERS \
    -u CLAUDE_CODE_USE_FOUNDRY \
    -u CLAUDE_CODE_SIMULATE_PROXY_USAGE \
    -u CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS \
    AIRKIT_AUDIT_ENABLED=1 \
    "${_oauth_env[@]}" \
    "${_launch_command[@]}" "${_audit_args[@]}" "$@"
}

codex-sub() {
  local _bin _codex_home
  _bin=$(whence -p codex) || { echo "codex not found" >&2; return 127; }
  _codex_home="${CODEX_SUB_HOME:-$HOME/.codex-sub}"
  mkdir -p "$_codex_home" || return

  # Keep ~/.codex untouched; CODEX_HOME gives the subscription account its own
  # auth.json, config.toml, sessions, and logs under ~/.codex-sub by default.
  CODEX_HOME="$_codex_home" \
    env -u OPENAI_API_KEY \
    -u OPENAI_BASE_URL \
    -u OPENAI_API_BASE \
    -u OPENAI_ORG_ID \
    -u OPENAI_ORGANIZATION \
    -u OPENAI_PROJECT \
    -u AZURE_OPENAI_API_KEY \
    -u AZURE_OPENAI_ENDPOINT \
    -u AZURE_OPENAI_API_VERSION \
    -u ANTHROPIC_AUTH_TOKEN \
    -u ANTHROPIC_API_KEY \
    -u ANTHROPIC_BASE_URL \
    "$_bin" "$@"
}

# Optional: Headroom compression wrappers (hr-*).
# Route the AI CLIs above through a local Headroom proxy
# (https://headroom-docs.vercel.app) for prompt/tool-output compression and
# prefix-cache alignment. Install once: `uv tool install 'headroom-ai[all]'`.
# Type `hr-help` once loaded. Design choices (don't change without reason):
#  - PURE `headroom proxy` (NOT `headroom wrap`, which durably rewrites
#    ~/.codex/config.toml + ~/AGENTS.md). Pure proxy mutates nothing on disk;
#    we only set ANTHROPIC_BASE_URL / OPENAI_BASE_URL per child process.
#  - One proxy port per upstream (a running proxy is reused regardless of
#    target). Upstream pinned via ANTHROPIC_TARGET_API_URL / OPENAI_TARGET_API_URL.
#  - Cache-first Claude paths use `--mode cache` so prior turns stay byte-stable;
#    web_litellm uses `--mode token` because its routed models do not promise a
#    provider prefix-cache contract. The latter may rewrite prior turns for savings.
#  - Each proxy runs --code-aware --intercept-tool-results. Kompress stays off by
#    default because the LLMLingua/torch path adds 20-30s/req on CPU.
# Note: heavily prefix-cached sessions legitimately show compressed=0 with
# cache_saved>0 — cache beats compression there; that is success, not a bug.
# _HR_PORT_SUB=8801      # subscription OAuth -> api.anthropic.com
# _HR_PORT_OP=8802       # bare claude -> your internal gateway
# _HR_PORT_JB=8803       # JBridge
# _HR_PORT_AIR=8804      # airclaude -> CCR (127.0.0.1:3456)
# _HR_PORT_CODEX=8805    # codex -> api.openai.com
# _HR_PORT_CODEXSUB=8806 # codex subscription (ChatGPT)
